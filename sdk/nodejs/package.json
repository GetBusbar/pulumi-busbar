{
    "name": "@getbusbar/pulumi-busbar",
    "version": "${VERSION}",
    "description": "A Pulumi package for creating and managing Busbar LLM gateway resources through its admin API.",
    "keywords": [
        "pulumi",
        "busbar",
        "llm",
        "gateway",
        "ai",
        "category/utility"
    ],
    "homepage": "https://getbusbar.com",
    "repository": "https://github.com/getbusbar/pulumi-busbar",
    "license": "Apache-2.0",
    "scripts": {
        "build": "tsc && node -e \"require('fs').copyFileSync('package.json', 'bin/package.json')\"",
        "prepack": "npm run build",
        "test": "npm run build && node --test tests/virtualKey.test.js"
    },
    "dependencies": {
        "@pulumi/pulumi": "^3.0.0"
    },
    "devDependencies": {
        "@types/node": "^18",
        "typescript": "^4.7.0"
    },
    "pulumi": {
        "resource": true,
        "name": "busbar",
        "server": "github://api.github.com/getbusbar"
    },
    "main": "bin/index.js",
    "types": "bin/index.d.ts",
    "files": [
        "bin",
        "README.md"
    ]
}
